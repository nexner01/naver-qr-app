<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NaverQRApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/naver_green</item>
        <item name="colorPrimaryVariant">#02B150</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/naver_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NaverQRApp.Fullscreen" parent="Theme.NaverQRApp">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
